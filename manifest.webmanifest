{
  "id": "/geocam-app",
  "name": "GeoCam – GPS-Kamera",
  "short_name": "GeoCam",
  "description": "Fotos und Videos mit Ort, Adresse, Datum und eigenem Logo stempeln, nach Ort sortieren und per Google Maps hinnavigieren.",
  "lang": "de",
  "dir": "ltr",
  "start_url": "./index.html?app=1",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#0b1220",
  "background_color": "#0b1220",
  "categories": ["photo", "navigation", "utilities"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Galerie nach Ort",
      "short_name": "Galerie",
      "url": "./index.html?go=gal",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Karte",
      "short_name": "Karte",
      "url": "./index.html?go=map",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
